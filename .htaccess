# This file protects the THEME folder only (public_html/wp-content/themes/apnamerit/).
# The repo is deployed as-is, so block docs, scripts and source notes from the web.
# content/*.html (page bodies) is served only through the pages, never directly.
# data/*.json stays public on purpose (master plan section 6: public data).

Options -Indexes

<FilesMatch "\.(md|py|sh|env|example|lock|log|gitignore)$">
	Require all denied
</FilesMatch>

<IfModule mod_alias.c>
	RedirectMatch 404 /(scripts|sources|content|\.git)(/|$)
</IfModule>

# Security headers for theme files (HTML pages get theirs from inc/seo.php).
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Versioned assets (?ver=filemtime / AM_VERSION) can be cached for a year.
<IfModule mod_headers.c>
	<FilesMatch "\.(js|css|svg)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>
