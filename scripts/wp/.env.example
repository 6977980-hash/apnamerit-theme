# Copy to scripts/wp/.env (git-ignored) and fill in from hPanel -> Advanced -> SSH Access.
AM_SSH_HOST=000.000.000.000
AM_SSH_PORT=65002
AM_SSH_USER=u000000000
# WordPress root on the server (folder that contains wp-config.php)
AM_WP_PATH=domains/apnamerit.com/public_html
# Optional: path to the private key to use
AM_SSH_KEY=
